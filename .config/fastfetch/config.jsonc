//  Copyright (c) Anon4You - https://github.com/Anon4You/dotfiles
//  Fastfetch image rendering in Termux using chafa.
//  Note:
//    - timg can also be used instead of chafa.
//    - On Termux, we use "type": "command-raw" because fastfetch
//      is not able to render/print the image without it.
//    - Replace "/path/to/image.png" below with the actual path to
//      your own image, otherwise the logo will not display.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "command-raw",
        "source": "chafa --size 50x35 /path/to/image.png",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "",
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 18
        }
    },
    "modules": [
        "break",
        "break",

        {
            "type": "title",
            "format": "\u001b[38;5;66m{user-name}\u001b[38;5;74m@\u001b[38;5;176m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;30m━\u001b[38;5;30m━\u001b[38;5;66m━\u001b[38;5;67m━\u001b[38;5;67m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;176m━\u001b[38;5;170m━\u001b[38;5;170m━\u001b[38;5;169m━\u001b[38;5;169m━\u001b[38;5;169m━\u001b[38;5;168m━\u001b[38;5;168m━\u001b[0m"
        },
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;30m─\u001b[38;5;66m─\u001b[38;5;74m─\u001b[38;5;104m─\u001b[38;5;140m─\u001b[38;5;176m─\u001b[38;5;170m─\u001b[38;5;168m─\u001b[0m\u001b[1m\u001b[38;5;67m OS \u001b[0m\u001b[38;5;168m─\u001b[38;5;170m─\u001b[38;5;176m─\u001b[38;5;140m─\u001b[38;5;104m─\u001b[38;5;74m─\u001b[38;5;66m─\u001b[38;5;30m─\u001b[0m"
        },
        {
            "type": "os",
            "key": " ├ 󰣇 ",
            "keyColor": "66"
        },
        {
            "type": "kernel",
            "key": " ├   ",
            "keyColor": "66"
        },
        {
            "type": "packages",
            "key": " ├ 󰏗 ",
            "keyColor": "66"
        },
        {
            "type": "shell",
            "key": " └ 󰅐 ",
            "keyColor": "66"
        },
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;30m─\u001b[38;5;66m─\u001b[38;5;74m─\u001b[38;5;104m─\u001b[38;5;140m─\u001b[38;5;176m─\u001b[38;5;170m─\u001b[38;5;168m─\u001b[0m\u001b[1m\u001b[38;5;74m UI \u001b[0m\u001b[38;5;168m─\u001b[38;5;170m─\u001b[38;5;176m─\u001b[38;5;140m─\u001b[38;5;104m─\u001b[38;5;74m─\u001b[38;5;66m─\u001b[38;5;30m─\u001b[0m"
        },
        {
            "type": "wm",
            "key": " ├ 󰕌 ",
            "keyColor": "74"
        },
        {
            "type": "wmtheme",
            "key": " ├     ",
            "keyColor": "74"
        },
        {
            "type": "icons",
            "key": " ├ 󰝥 ",
            "keyColor": "74"
        },
        {
            "type": "cursor",
            "key": " ├ 󰟝 ",
            "keyColor": "74"
        },
        {
            "type": "terminal",
            "key": " ├ 󰆍 ",
            "keyColor": "74"
        },
        {
            "type": "terminalfont",
            "key": " └ 󰙁 ",
            "keyColor": "74"
        },
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;30m─\u001b[38;5;66m─\u001b[38;5;74m─\u001b[38;5;104m─\u001b[38;5;140m─\u001b[38;5;176m─\u001b[38;5;170m─\u001b[38;5;168m─\u001b[0m\u001b[1m\u001b[38;5;104m HW \u001b[0m\u001b[38;5;168m─\u001b[38;5;170m─\u001b[38;5;176m─\u001b[38;5;140m─\u001b[38;5;104m─\u001b[38;5;74m─\u001b[38;5;66m─\u001b[38;5;30m─\u001b[0m"
        },
        {
            "type": "host",
            "format": "{5} {1} ({2})",
            "key": " ├ 󰑮 ",
            "keyColor": "104"
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ├ 󰧨 ",
            "keyColor": "104"
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12}",
            "key": " ├ 󰍛 ",
            "keyColor": "104"
        },
        {
            "type": "memory",
            "format": "{used} / {total}",
            "key": " ├ 󰍟 ",
            "keyColor": "104"
        },
        {
            "type": "memory",
            "percent": {
                "type": [
                    "bar",
                    "hide-others"
                ]
            },
            "key": "      "
        },
        {
            "type": "swap",
            "key": " ├ 󰂺 ",
            "keyColor": "104"
        },
        {
            "type": "disk",
            "key": " ├ 󰆤 ",
            "keyColor": "104"
        },
        {
            "type": "monitor",
            "key": " └ 󰹫 ",
            "keyColor": "104"
        },
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;30m─\u001b[38;5;66m─\u001b[38;5;74m─\u001b[38;5;104m─\u001b[38;5;140m─\u001b[38;5;176m─\u001b[38;5;170m─\u001b[38;5;168m─\u001b[0m\u001b[1m\u001b[38;5;176m SYS \u001b[0m\u001b[38;5;168m─\u001b[38;5;170m─\u001b[38;5;176m─\u001b[38;5;140m─\u001b[38;5;104m─\u001b[38;5;74m─\u001b[38;5;66m─\u001b[38;5;30m─\u001b[0m"
        },
        {
            "type": "uptime",
            "key": " ├ 󰅐 ",
            "keyColor": "176"
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ├ 󰹩 ",
            "keyColor": "176"
        },
        {
            "type": "command",
            "key": " ├ 󰇥 ",
            "keyColor": "176",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "command",
            "key": " └ 󰽴 ",
            "keyColor": "176",
            "text": "splash=$(hyprctl splash);echo $splash"
        },
        "break",

        {
            "type": "custom",
            "format": "\u001b[38;5;30m│\u001b[38;5;30m│\u001b[38;5;66m│\u001b[38;5;67m│\u001b[38;5;67m│\u001b[38;5;73m│\u001b[38;5;73m│\u001b[38;5;73m│\u001b[38;5;73m│\u001b[38;5;73m│\u001b[38;5;73m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;74m│\u001b[38;5;104m│\u001b[38;5;104m│\u001b[38;5;104m│\u001b[38;5;104m│\u001b[38;5;104m│\u001b[38;5;140m│\u001b[38;5;140m│\u001b[38;5;140m│\u001b[38;5;140m│\u001b[38;5;176m│\u001b[38;5;170m│\u001b[38;5;170m│\u001b[38;5;169m│\u001b[38;5;169m│\u001b[38;5;169m│\u001b[38;5;168m│\u001b[38;5;168m│\u001b[0m"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;168m═\u001b[38;5;168m═\u001b[38;5;169m═\u001b[38;5;169m═\u001b[38;5;169m═\u001b[38;5;170m═\u001b[38;5;170m═\u001b[38;5;176m═\u001b[38;5;140m═\u001b[38;5;140m═\u001b[38;5;140m═\u001b[38;5;140m═\u001b[38;5;104m═\u001b[38;5;104m═\u001b[38;5;104m═\u001b[38;5;104m═\u001b[38;5;104m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;74m═\u001b[38;5;73m═\u001b[38;5;73m═\u001b[38;5;73m═\u001b[38;5;73m═\u001b[38;5;73m═\u001b[38;5;73m═\u001b[38;5;67m═\u001b[38;5;67m═\u001b[38;5;66m═\u001b[38;5;30m═\u001b[38;5;30m═\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;30m━\u001b[38;5;30m━\u001b[38;5;66m━\u001b[38;5;67m━\u001b[38;5;67m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;73m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;74m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;104m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;140m━\u001b[38;5;176m━\u001b[38;5;170m━\u001b[38;5;170m━\u001b[38;5;169m━\u001b[38;5;169m━\u001b[38;5;169m━\u001b[38;5;168m━\u001b[38;5;168m━\u001b[0m"
        },
        "break",
        "break"
    ]
}
